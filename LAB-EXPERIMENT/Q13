# Hill Cipher Known Plaintext Attack

import numpy as np

# Function to find modular inverse
def mod_inverse(a, m):
    for x in range(1, m):
        if (a * x) % m == 1:
            return x
    return None

# Known Plaintext Matrix
P = np.array([[7, 11],
              [4, 15]])

# Corresponding Ciphertext Matrix
C = np.array([[8, 0],
              [7, 19]])

# Determinant of P
det = int(round(np.linalg.det(P)))
det = det % 26

# Modular inverse of determinant
det_inv = mod_inverse(det, 26)

if det_inv is None:
    print("Plaintext matrix is not invertible modulo 26")
else:
    # Adjoint Matrix
    adj = np.array([[P[1,1], -P[0,1]],
                    [-P[1,0], P[0,0]]])

    # Inverse of Plaintext Matrix modulo 26
    P_inv = (det_inv * adj) % 26

    # Recover Key Matrix
    K = np.dot(C, P_inv) % 26

    print("Recovered Key Matrix:")
    print(K)

