matrix = [
    ['M','F','H','I','K'],
    ['U','N','O','P','Q'],
    ['Z','V','W','X','Y'],
    ['E','L','A','R','G'],
    ['D','S','T','B','C']
]

def find_pos(ch):
    if ch == 'J':
        ch = 'I'

    for r in range(5):
        for c in range(5):
            if matrix[r][c] == ch:
                return r, c

def prepare_text(text):
    text = ''.join(ch.upper() for ch in text if ch.isalpha())
    text = text.replace('J', 'I')

    result = ""
    i = 0

    while i < len(text):
        a = text[i]

        if i + 1 < len(text):
            b = text[i + 1]

            if a == b:
                result += a + 'X'
                i += 1
            else:
                result += a + b
                i += 2
        else:
            result += a + 'X'
            i += 1

    return result

def encrypt_pair(a, b):
    r1, c1 = find_pos(a)
    r2, c2 = find_pos(b)

    if r1 == r2:   # Same row
        return matrix[r1][(c1 + 1) % 5] + matrix[r2][(c2 + 1) % 5]

    elif c1 == c2: # Same column
        return matrix[(r1 + 1) % 5][c1] + matrix[(r2 + 1) % 5][c2]

    else:          # Rectangle rule
        return matrix[r1][c2] + matrix[r2][c1]

plaintext = "Must see you over Cadogan West. Coming at once."

prepared = prepare_text(plaintext)

ciphertext = ""

for i in range(0, len(prepared), 2):
    ciphertext += encrypt_pair(prepared[i], prepared[i+1])

print("Prepared Text :", prepared)
print("Cipher Text   :", ciphertext)

